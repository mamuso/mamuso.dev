{
  "name": "mamuso.dev",
  "version": "1.0.2",
  "description": "Why does it hurt so much to hit your funny bone?",
  "private": true,
  "packageManager": "pnpm@10.34.9+sha512.f49b5a8ea0fdedb44bb3c0c1d6575092a53c2950d95b7ad15df11f17974877a2de3a01c07e934e9b28ce716e51c09a94962c7306d09be2e1e4b18a8c8762fd32",
  "scripts": {
    "dev": "next dev",
    "postinstall": "node -e \"const fs=require('fs');fs.mkdirSync('.claude',{recursive:true});try{fs.symlinkSync('../.agents/skills','.claude/skills')}catch(e){if(e.code!=='EEXIST')throw e}\"",
    "build": "git submodule update --init ${VERCEL:+--remote} && pnpm content:check && pnpm run assets && pnpm run rss && next build",
    "start": "next start",
    "lint": "eslint .",
    "shader:check": "for shader in app/components/*.wgsl; do VGPU_DAWN_FLAGS=backend=null vgpu check \"$shader\" --require-validation || exit; done",
    "rss": "ts-node --project ./node.tsconfig.json lib/feed",
    "assets": "ts-node --project ./node.tsconfig.json lib/assets",
    "photos": "node scripts/photos.mjs",
    "photos:test": "node --test lib/photo-import.test.mjs",
    "photos:interaction:test": "node --test app/components/photoInteraction.test.mjs",
    "metadata:test": "node --test scripts/metadata.test.mjs scripts/function-size.test.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test lib/*.test.mjs app/components/*.test.mjs tests/*.test.mjs",
    "content:check": "node scripts/content-check.mjs",
    "check": "pnpm content:check && pnpm lint && pnpm typecheck && pnpm test && pnpm shader:check",
    "smoke:test": "node scripts/prepare-smoke.mjs && playwright test",
    "smoke:core": "pnpm smoke:test --grep-invert 'cartridge-(blow|buffer|readiness|swipe)\\.spec'",
    "smoke:gestures": "pnpm smoke:test --grep 'cartridge-(blow|buffer|readiness|swipe)\\.spec'",
    "verify": "pnpm check && pnpm build && pnpm metadata:test && pnpm smoke:test"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@stylexjs/stylex": "^0.19.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "fs-extra": "^11.4.1",
    "gray-matter": "^4.0.3",
    "markdown-to-jsx": "^9.10.4",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-tweet": "^3.3.1",
    "shiki": "^4.5.0",
    "three": "^0.187.0",
    "vgpu": "0.6.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@stylexjs/babel-plugin": "^0.19.1",
    "@stylexjs/eslint-plugin": "^0.19.1",
    "@stylexjs/postcss-plugin": "^0.19.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "^0.187.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vgpu/wgsl": "0.6.0",
    "@webgpu/types": "^0.1.74",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.3",
    "exiftool-vendored": "^39.1.0",
    "feed": "^6.0.0",
    "marked": "^18.1.2",
    "postcss": "8.5.32",
    "quantize": "^1.0.2",
    "sharp": "0.35.5",
    "ts-node": "^10.9.2",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "engines": {
    "node": "24.x"
  }
}
