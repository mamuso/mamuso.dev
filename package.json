{
  "name": "mamuso.dev",
  "version": "1.0.2",
  "description": "Why does it hurt so much to hit your funny bone?",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "git submodule init && git submodule update --remote && pnpm run assets && pnpm run rss && next build",
    "start": "next start",
    "lint": "next lint",
    "rss": "pnpm exec ts-node --project ./node.tsconfig.json lib/feed",
    "assets": "pnpm exec ts-node --project ./node.tsconfig.json lib/assets",
    "photos": "ts-node --project ./node.tsconfig.json lib/photos"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/analytics": "^2.0.1",
    "@vercel/og": "^0.11.1",
    "@vercel/speed-insights": "^2.0.0",
    "fs-extra": "^11.3.5",
    "geist": "^1.7.0",
    "gray-matter": "^4.0.3",
    "markdown-to-jsx": "^9.8.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/color-thief-node": "^1.0.4",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.8.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/rss": "^0.0.32",
    "color-thief-node": "^1.0.4",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.2.6",
    "fast-exif": "^2.0.1",
    "feed": "^5.2.1",
    "marked": "^18.0.3",
    "sass": "^1.99.0",
    "sharp": "^0.34.5",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3"
    },
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "canvas",
      "sharp",
      "unrs-resolver"
    ]
  }
}
