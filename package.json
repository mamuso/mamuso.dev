    "@types/fs-extra": "^11.0.4",
    "@types/node": "^26.1.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "color-thief-node": "^1.0.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "fast-exif": "^2.0.1",
    "feed": "^6.0.0",
    "marked": "^18.0.7",
